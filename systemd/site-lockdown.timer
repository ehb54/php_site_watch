# site-lockdown (installed by setup.sh): while the block is on, check every minute that a firewall
# reload or "nft flush ruleset" has not removed it.
[Unit]
Description=Check every minute that the site-lockdown block is still in place

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
